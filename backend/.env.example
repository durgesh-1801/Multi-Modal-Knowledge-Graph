# Enterprise Compliance Knowledge Graph Platform Environment Configuration

# Application Metadata
APP_NAME="Enterprise Compliance Knowledge Graph"
APP_VERSION="0.1.0"
DEBUG=true

# AI Provider Configurations (Placeholder for future phases)
GEMINI_API_KEY="your-gemini-api-key-here"

# Vector Database Settings (Placeholder for future phases)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="your-qdrant-api-key-here"

# Graph Database Settings (Placeholder for future phases)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-secure-password"

# File Upload Settings
UPLOAD_DIRECTORY="uploads"
MAX_UPLOAD_SIZE=104857600  # Maximum upload file size in bytes (100MB)

# Logging Settings (TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"
