############################
# Application Configuration
############################
# Name of the backend application instance
APP_NAME=Multi-Modal Knowledge Graph
# Deployment environment (development, staging, production)
APP_ENV=development
# API semantic version string
APP_VERSION=0.1.0
# Toggle verbose debug mode and interactive documentation
DEBUG=True
# Binding host address for Uvicorn server
HOST=0.0.0.0
# Binding port for Uvicorn server
PORT=8000

############################
# Google Gemini AI Integration
############################
# Secret API key for Google Gemini AI models (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

############################
# Neo4j Knowledge Graph Integration
############################
# Bolt connection protocol URI for Neo4j database server
NEO4J_URI=bolt://localhost:7687
# Authentication username for Neo4j database
NEO4J_USERNAME=neo4j
# Authentication password for Neo4j database
NEO4J_PASSWORD=password
# Target Neo4j database instance name
NEO4J_DATABASE=neo4j
# Maximum concurrent connection pool size for Neo4j driver
NEO4J_MAX_CONNECTION_POOL_SIZE=50

############################
# Qdrant Vector Database Integration
############################
# Server hostname for Qdrant vector database
QDRANT_HOST=localhost
# Server HTTP port for Qdrant vector database
QDRANT_PORT=6333
# Connection URL override for Qdrant vector store
QDRANT_URL=http://localhost:6333
# Optional API authentication key for Qdrant Cloud
QDRANT_API_KEY=your_qdrant_api_key_here
# Target Qdrant vector collection name
QDRANT_COLLECTION=knowledge_graph
QDRANT_COLLECTION_NAME=compliance_documents

############################
# Embeddings & Speech AI Models
############################
# HuggingFace model identifier string for dense vector embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
# OpenAI Whisper speech-to-text model size variant (tiny, base, small, medium, large-v3)
WHISPER_MODEL=large-v3

############################
# Upload & Storage Rules
############################
# Directory path for storing uploaded compliance documents
UPLOAD_DIR=uploads
UPLOAD_DIRECTORY=uploads
# Maximum allowable file upload size limit in Megabytes
MAX_UPLOAD_SIZE_MB=100
# Maximum allowable file upload size limit in Bytes (100MB = 104857600)
MAX_UPLOAD_SIZE=104857600

############################
# Storage Directories
############################
# Relative path for temporary file processing
TEMP_DIR=temp
# Relative path for cache storage
CACHE_DIR=cache

############################
# Observability & Logging
############################
# Log severity threshold filter (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

############################
# RAG Rank Fusion Weights
############################
# Dense vector similarity score weight (0.0 to 1.0)
RAG_WEIGHT_VECTOR=0.45
# Knowledge graph connectivity score weight (0.0 to 1.0)
RAG_WEIGHT_GRAPH=0.35
# Exact entity token match score weight (0.0 to 1.0)
RAG_WEIGHT_ENTITY=0.20

############################
# LLM Execution Parameters
############################
# Target Google Gemini LLM model identifier
LLM_MODEL=gemini-2.5-flash
# Temperature parameter controlling response creativity (0.0 to 1.0)
TEMPERATURE=0.1
# Top-K candidate sampling parameter
TOP_K=5
